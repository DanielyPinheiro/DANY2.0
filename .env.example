# Opcional em produção: URL canónica para og:image/twitter e link rel="canonical"
# Sem barra no fim (produção Vercel deste site: https://dany2-site.vercel.app)
# VITE_PUBLIC_SITE_URL=https://dany2-site.vercel.app
#
# Prefixo do Vite (deve coincidir com `vite build --base=`). Raiz do site: /
# GitHub Pages neste repo: /DANY2.0/
# VITE_BASE_PATH=/
#
# Vercel: define a mesma variável em Project → Settings → Environment Variables
# (nome em MAIÚSCULAS: VITE_PUBLIC_SITE_URL).
# - Production: URL final do site (domínio ou https://<projeto>.vercel.app).
# - Preview: opcional; vazio evita forçar canonical em cada PR, ou usa a URL da preview.
#
# ── Formulário de contato (server-only — NÃO usar prefixo VITE_) ───────────────
# E-mail de destino dos briefings recebidos pelo site.
CONTACT_TO_EMAIL=
# API Key do Resend (https://resend.com/api-keys) — plano free: 3 000 e-mails/mês.
RESEND_API_KEY=
# E-mail institucional de referência / fallback se CONTACT_TO_EMAIL não estiver definido.
SITE_EMAIL=
