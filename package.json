{
  "name": "dany-tech-alquimia",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:auto": "npm install && vite dev",
    "build": "node scripts/generate-robots-sitemap.mjs && vite build && tsc --noEmit",
    "build:gh-pages": "node scripts/generate-robots-sitemap.mjs --base=/DANY2.0/ && vite build --base=/DANY2.0/ && tsc --noEmit",
    "preview": "vite preview",
    "start": "npx --yes srvx --prod -s ../client dist/server/server.js",
    "routes:generate": "npx --yes @tanstack/router-cli@latest generate",
    "lint": "eslint src",
    "validate": "npm run build && node scripts/validate-preview.mjs",
    "images:placeholders": "node scripts/generate-placeholder-pngs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.65",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nitro": "3.0.260429-beta",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "8.0.11"
  }
}
